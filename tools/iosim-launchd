#!/usr/bin/env python3
"""Minimal launchd_sim stand-in.

Owns the per-device runtime state while a device is booted, boots the system
UI (SpringBoard), owns the bootstrap service namespace, exposes a Unix socket
for service requests, and exits cleanly on SIGTERM (simctl shutdown). The
namespace maps registered service names to the pid that owns them; guest
processes carry messages over abstract Unix sockets derived from the device
UDID and the name.
"""

import importlib.util
from importlib.machinery import SourceFileLoader
import json
import os
from pathlib import Path
import plistlib
import select
import signal
import socket
import subprocess
import sys
import time

running = True
springboard_pid = None
# LaunchDaemon jobs by label and the context needed to start them.
jobs = {}
job_ctx = {}


def load_ctl():
    here = os.path.dirname(os.path.abspath(__file__))
    loader = SourceFileLoader("iosimctl", os.path.join(here, "iosimctl"))
    spec = importlib.util.spec_from_loader("iosimctl", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def on_term(signum, frame):
    global running
    running = False


def stop_springboard():
    global springboard_pid
    if springboard_pid:
        try:
            # Suspended apps ignore SIGTERM until continued.
            os.killpg(springboard_pid, signal.SIGCONT)
            os.killpg(springboard_pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        springboard_pid = None


# ----------------------------------------------------------- launchd jobs
#
# A device's Library/LaunchDaemons holds job plists shaped like the real
# launchd ones: Label, ProgramArguments, MachServices, RunAtLoad, KeepAlive
# and EnvironmentVariables. RunAtLoad jobs start when launchd starts or when
# the job is loaded; a MachServices name that is looked up starts its job on
# demand. Every job is a normal guest process under the loader, so it gets the
# device environment and can register its own Mach service.

def pid_alive(pid):
    if not pid or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def job_log_path(device_dir, label):
    safe = "".join(c if c.isalnum() or c in ".-_" else "_" for c in label)
    return os.path.join(device_dir, "logs", safe + ".log")


def resolve_job_program(program, job):
    path = Path(program)
    if path.is_absolute():
        if path.exists():
            return str(path)
        runtime = job_ctx["ctl"].runtime_root() / program.lstrip("/")
        if runtime.exists():
            return str(runtime)
        return str(path)
    return str(Path(job["plist"]).parent / program)


def start_job(job):
    ctx = job_ctx
    if not ctx:
        return
    cmd = [ctx["ctl"].loader_path()]
    for p in ctx["dev"].get("dylibPaths", []):
        cmd += ["--dylib-path", p]
    cmd.append(resolve_job_program(job["program"][0], job))
    cmd += job["program"][1:]
    env = ctx["ctl"].device_environment(ctx["udid"], ctx["dev"])
    env.update(job.get("environment", {}))
    log_path = job_log_path(ctx["device_dir"], job["label"])
    log = open(log_path, "ab")
    proc = subprocess.Popen(cmd, env=env, stdout=log, stderr=log,
                            start_new_session=True, cwd=ctx["device_dir"])
    log.close()
    job["pid"] = proc.pid
    job["lastStart"] = time.monotonic()
    print(f"launchd_sim: job {job['label']} started pid={proc.pid}",
          flush=True)


def parse_job(path):
    with open(path, "rb") as f:
        pl = plistlib.load(f)
    label = str(pl.get("Label") or Path(path).stem)
    if not label or "/" in label:
        raise ValueError("bad job label")
    if pl.get("ProgramArguments"):
        program = [str(a) for a in pl["ProgramArguments"]]
    elif pl.get("Program"):
        program = [str(pl["Program"])]
    else:
        raise ValueError("missing ProgramArguments")
    mach = pl.get("MachServices") or {}
    services = [str(k) for k in mach.keys()] if isinstance(mach, dict) else []
    env = pl.get("EnvironmentVariables") or {}
    return {
        "label": label,
        "plist": str(path),
        "program": program,
        "machServices": services,
        "runAtLoad": bool(pl.get("RunAtLoad", False)),
        "keepAlive": pl.get("KeepAlive") is True,
        "environment": {str(k): str(v) for k, v in env.items()},
        "pid": 0,
        "lastStart": 0.0,
    }


def scan_jobs(device_dir):
    found = {}
    daemons = Path(device_dir) / "Library" / "LaunchDaemons"
    if not daemons.is_dir():
        return found
    for path in sorted(daemons.glob("*.plist")):
        try:
            job = parse_job(path)
        except Exception as exc:
            print(f"launchd_sim: bad job plist {path.name}: {exc}",
                  flush=True)
            continue
        found[job["label"]] = job
    return found


def prune_jobs():
    for job in jobs.values():
        if job["pid"] and not pid_alive(job["pid"]):
            job["pid"] = 0
            if job["keepAlive"] and \
                    time.monotonic() - job.get("lastStart", 0.0) > 1.0:
                start_job(job)


def load_job_into_runtime(path):
    job = parse_job(path)
    jobs[job["label"]] = job
    print(f"launchd_sim: job {job['label']} loaded", flush=True)
    if job["runAtLoad"]:
        start_job(job)
    return {"ok": True, "label": job["label"]}


def job_for_service(name):
    for job in jobs.values():
        if name in job["machServices"]:
            return job
    return None


def stop_jobs():
    for job in jobs.values():
        pid = job.get("pid", 0)
        if not pid:
            continue
        try:
            os.killpg(pid, signal.SIGCONT)
            os.killpg(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        job["pid"] = 0


def boot_springboard(ctl, device_dir, udid, name):
    """Start the system UI with the apps installed on this device."""
    global springboard_pid
    state = ctl.load_state()
    dev = state["devices"].get(udid)
    if dev is None:
        print("launchd_sim: device not in state; skipping SpringBoard",
              flush=True)
        return
    manifest = ctl.write_springboard_manifest(udid, dev)
    sb = ctl.runtime_root() / "System" / "Library" / "CoreServices" / \
        "SpringBoard.app" / "SpringBoard"
    if not sb.exists():
        print("launchd_sim: SpringBoard not built (tools/build_runtime.sh)",
              flush=True)
        return
    var_run = os.path.join(device_dir, "var", "run")
    fifo = ctl.event_fifo_path(udid)
    if not fifo.exists():
        os.mkfifo(str(fifo))
    env = ctl.device_environment(udid, dev)
    env["IOSIM_SHELL"] = "1"
    env["IOSIM_SHELL_APPS"] = str(manifest)
    env["IOSIM_EVENT_FIFO"] = str(fifo)
    cmd = [ctl.loader_path()]
    for p in dev.get("dylibPaths", []):
        cmd += ["--dylib-path", p]
    cmd += [str(sb)]
    log_path = os.path.join(device_dir, "logs", "springboard.log")
    log = open(log_path, "ab")
    proc = subprocess.Popen(cmd, env=env, stdout=log, stderr=log,
                            start_new_session=True, cwd=os.path.dirname(device_dir))
    springboard_pid = proc.pid
    log.close()
    print(f"launchd_sim: SpringBoard started pid={proc.pid}", flush=True)


def main():
    global running
    if len(sys.argv) < 4:
        print("usage: iosim-launchd <device-dir> <udid> <name>", file=sys.stderr)
        return 2
    device_dir, udid, name = sys.argv[1], sys.argv[2], sys.argv[3]
    var_run = os.path.join(device_dir, "var", "run")
    os.makedirs(var_run, exist_ok=True)
    os.makedirs(os.path.join(device_dir, "logs"), exist_ok=True)
    # AF_UNIX paths are limited to 108 bytes; the device set path can be
    # longer than that, so the control socket lives under /tmp.
    sock_path = f"/tmp/iosim-launchd-{udid}.sock"
    state_path = os.path.join(var_run, "launchd.json")
    try:
        os.unlink(sock_path)
    except FileNotFoundError:
        pass

    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)

    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(sock_path)
    srv.listen(8)
    srv.setblocking(False)
    os.chmod(sock_path, 0o600)

    state = {
        "pid": os.getpid(),
        "udid": udid,
        "name": name,
        "startedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "services": {},
    }

    def persist():
        state["springboardPid"] = springboard_pid
        with open(state_path, "w") as f:
            json.dump(state, f, indent=2)

    def prune_services():
        """Forget names whose registering process no longer exists."""
        services = state["services"]
        for svc in list(services):
            pid = services[svc].get("pid", 0)
            try:
                os.kill(pid, 0)
            except (ProcessLookupError, PermissionError):
                if pid:
                    del services[svc]

    def register_service(name, pid):
        prune_services()
        services = state["services"]
        if not name or len(name) > 88 or pid <= 0:
            return {"ok": False, "error": "bad request"}
        held = services.get(name)
        if held is not None:
            return {"ok": False, "error": "active"}
        services[name] = {
            "pid": pid,
            "registeredAt": time.strftime("%Y-%m-%dT%H:%M:%SZ",
                                          time.gmtime()),
        }
        persist()
        print(f"launchd_sim: service {name} registered by pid {pid}",
              flush=True)
        return {"ok": True}

    def lookup_service(name):
        prune_services()
        held = state["services"].get(name)
        if held is not None and pid_alive(held.get("pid", 0)):
            return {"ok": True, "pid": held.get("pid", 0)}
        prune_jobs()
        job = job_for_service(name)
        if job is None:
            return {"ok": False, "error": "unknown service"}
        if not pid_alive(job["pid"]):
            start_job(job)
        # The client retries while the job starts and registers the name.
        return {"ok": False, "error": "starting"}

    persist()
    print(f"launchd_sim: booting {name} ({udid}) pid={os.getpid()}", flush=True)

    ctl = load_ctl()
    dev = ctl.load_state().get("devices", {}).get(udid) or {}
    job_ctx.update({"ctl": ctl, "udid": udid, "dev": dev,
                    "device_dir": device_dir})
    jobs.update(scan_jobs(device_dir))

    try:
        boot_springboard(ctl, device_dir, udid, name)
    except Exception as exc:  # keep the boot anchor alive regardless
        print(f"launchd_sim: SpringBoard boot failed: {exc}", flush=True)
    for job in list(jobs.values()):
        if job["runAtLoad"]:
            start_job(job)
    persist()

    while running:
        try:
            ready, _, _ = select.select([srv], [], [], 0.5)
        except InterruptedError:
            continue
        if not ready:
            continue
        try:
            conn, _ = srv.accept()
        except BlockingIOError:
            continue
        with conn:
            conn.settimeout(1.0)
            try:
                data = conn.recv(65536)
                req = json.loads(data or b"{}")
            except Exception:
                req = {}
            cmd = req.get("cmd")
            if cmd == "ping":
                resp = {"ok": True, "pid": os.getpid()}
            elif cmd == "status":
                prune_services()
                prune_jobs()
                resp = {"ok": True, "state": state,
                        "jobs": [{"label": j["label"], "pid": j["pid"],
                                  "services": j["machServices"]}
                                 for j in jobs.values()]}
            elif cmd == "service_register":
                resp = register_service(str(req.get("name", "")),
                                        int(req.get("pid", 0) or 0))
            elif cmd == "service_lookup":
                resp = lookup_service(str(req.get("name", "")))
            elif cmd == "job_load":
                try:
                    resp = load_job_into_runtime(str(req.get("path", "")))
                except Exception as exc:
                    resp = {"ok": False, "error": str(exc)}
            elif cmd == "job_list":
                prune_jobs()
                resp = {"ok": True,
                        "jobs": [{"label": j["label"], "pid": j["pid"],
                                  "services": j["machServices"]}
                                 for j in jobs.values()]}
            elif cmd == "shutdown":
                resp = {"ok": True}
                running = False
            else:
                resp = {"ok": False, "error": "unknown command"}
            try:
                conn.sendall((json.dumps(resp) + "\n").encode())
            except OSError:
                pass

    stop_jobs()
    stop_springboard()
    try:
        os.unlink(sock_path)
    except FileNotFoundError:
        pass
    try:
        os.unlink(state_path)
    except FileNotFoundError:
        pass
    print("launchd_sim: shutting down", flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
