#!/usr/bin/env python3
"""Minimal launchd_sim stand-in.

Owns the per-device runtime state while a device is booted, boots the system
UI (SpringBoard), owns the bootstrap service namespace, exposes a Unix socket
for service requests, and exits cleanly on SIGTERM (simctl shutdown). The
namespace maps registered service names to the pid that owns them; guest
processes carry messages over abstract Unix sockets derived from the device
UDID and the name.
"""

import importlib.util
from importlib.machinery import SourceFileLoader
import json
import os
from pathlib import Path
import plistlib
import select
import signal
import socket
import subprocess
import sys
import time

running = True
springboard_pid = None
# LaunchDaemon jobs by label and the context needed to start them.
jobs = {}
job_ctx = {}


def load_ctl():
    here = os.path.dirname(os.path.abspath(__file__))
    loader = SourceFileLoader("iosimctl", os.path.join(here, "iosimctl"))
    spec = importlib.util.spec_from_loader("iosimctl", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def on_term(signum, frame):
    global running
    running = False


def stop_springboard():
    global springboard_pid
    if springboard_pid:
        try:
            # Suspended apps ignore SIGTERM until continued.
            os.killpg(springboard_pid, signal.SIGCONT)
            os.killpg(springboard_pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        springboard_pid = None


# ----------------------------------------------------------- launchd jobs
#
# A device's Library/LaunchDaemons holds job plists shaped like the real
# launchd ones: Label, ProgramArguments, MachServices, RunAtLoad, KeepAlive,
# StartInterval and EnvironmentVariables. RunAtLoad jobs start when launchd
# starts or when the job is loaded; a MachServices name that is looked up
# starts its job on demand; StartInterval jobs start again on their period. Every job is a normal guest process under the loader, so it gets the
# device environment and can register its own Mach service.

def pid_alive(pid):
    if not pid or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def job_log_path(device_dir, label):
    safe = "".join(c if c.isalnum() or c in ".-_" else "_" for c in label)
    return os.path.join(device_dir, "logs", safe + ".log")


def resolve_job_program(program, job):
    path = Path(program)
    if path.is_absolute():
        if path.exists():
            return str(path)
        runtime = job_ctx["ctl"].runtime_root() / program.lstrip("/")
        if runtime.exists():
            return str(runtime)
        return str(path)
    return str(Path(job["plist"]).parent / program)


def start_job(job):
    ctx = job_ctx
    if not ctx:
        return
    cmd = [ctx["ctl"].loader_path()]
    for p in ctx["dev"].get("dylibPaths", []):
        cmd += ["--dylib-path", p]
    cmd.append(resolve_job_program(job["program"][0], job))
    cmd += job["program"][1:]
    env = ctx["ctl"].device_environment(ctx["udid"], ctx["dev"])
    env.update(job.get("environment", {}))
    ensure_job_sockets(job)
    pass_fds = []
    activated = []
    for sock_name, listener in job.get("listeners", {}).items():
        fd = listener.fileno()
        if fd >= 0:
            pass_fds.append(fd)
            activated.append(f"{sock_name}={fd}")
    if activated:
        env["IOSIM_ACTIVATED_SOCKET_FDS"] = ",".join(activated)
    log_path = job_log_path(ctx["device_dir"], job["label"])
    log = open(log_path, "ab")
    proc = subprocess.Popen(cmd, env=env, stdout=log, stderr=log,
                            start_new_session=True, cwd=ctx["device_dir"],
                            pass_fds=tuple(pass_fds))
    log.close()
    job["proc"] = proc
    job["pid"] = proc.pid
    job["lastStart"] = time.monotonic()
    print(f"launchd_sim: job {job['label']} started pid={proc.pid}",
          flush=True)


def parse_job(path):
    with open(path, "rb") as f:
        pl = plistlib.load(f)
    label = str(pl.get("Label") or Path(path).stem)
    if not label or "/" in label:
        raise ValueError("bad job label")
    if pl.get("ProgramArguments"):
        program = [str(a) for a in pl["ProgramArguments"]]
    elif pl.get("Program"):
        program = [str(pl["Program"])]
    else:
        raise ValueError("missing ProgramArguments")
    mach = pl.get("MachServices") or {}
    services = [str(k) for k in mach.keys()] if isinstance(mach, dict) else []
    env = pl.get("EnvironmentVariables") or {}
    sockets_cfg = pl.get("Sockets") or {}
    sockets = []
    if isinstance(sockets_cfg, dict):
        for sock_name, conf in sockets_cfg.items():
            if not isinstance(conf, dict):
                continue
            sock_path = conf.get("SockPathName")
            if not sock_path:
                continue
            sockets.append({
                "name": str(sock_name),
                "path": str(sock_path),
                "type": str(conf.get("SockType", "stream")),
            })
    return {
        "label": label,
        "plist": str(path),
        "program": program,
        "machServices": services,
        "runAtLoad": bool(pl.get("RunAtLoad", False)),
        "keepAlive": pl.get("KeepAlive") is True,
        "startInterval": int(pl.get("StartInterval", 0) or 0),
        "environment": {str(k): str(v) for k, v in env.items()},
        "sockets": sockets,
        "listeners": {},
        "socketPaths": [],
        "proc": None,
        "pid": 0,
        "lastStart": (time.monotonic()
                      if int(pl.get("StartInterval", 0) or 0) > 0 else 0.0),
    }


def ensure_job_sockets(job):
    """Create the job's inherited listening sockets, like launchd does when a
    job with a Sockets dictionary is loaded. The descriptors stay in launchd
    until the job starts, then are handed to the guest by number."""
    if job.get("listeners"):
        return
    for sock in job.get("sockets", []):
        if sock["name"] in job["listeners"]:
            continue
        kind = socket.SOCK_DGRAM if sock["type"] == "dgram" \
            else socket.SOCK_STREAM
        path = sock["path"]
        try:
            if os.path.exists(path):
                os.unlink(path)
            parent = os.path.dirname(path)
            if parent:
                os.makedirs(parent, exist_ok=True)
            listener = socket.socket(socket.AF_UNIX, kind)
            listener.bind(path)
            if kind == socket.SOCK_STREAM:
                listener.listen(16)
            listener.setblocking(False)
            job["listeners"][sock["name"]] = listener
            job["socketPaths"].append(path)
            print(f"launchd_sim: job {job['label']} socket {sock['name']} "
                  f"listening at {path}", flush=True)
        except OSError as exc:
            print(f"launchd_sim: job {job['label']} socket {sock['name']} "
                  f"failed: {exc}", flush=True)


def scan_jobs(device_dir):
    found = {}
    daemons = Path(device_dir) / "Library" / "LaunchDaemons"
    if not daemons.is_dir():
        return found
    for path in sorted(daemons.glob("*.plist")):
        try:
            job = parse_job(path)
        except Exception as exc:
            print(f"launchd_sim: bad job plist {path.name}: {exc}",
                  flush=True)
            continue
        found[job["label"]] = job
    return found


def prune_jobs():
    for job in list(jobs.values()):
        proc = job.get("proc")
        if proc is not None:
            # poll() also reaps the child, so a finished job is really gone
            # instead of lingering as a zombie that kill(pid, 0) still sees.
            if proc.poll() is None:
                continue
            job["proc"] = None
            job["pid"] = 0
        elif job["pid"] and not pid_alive(job["pid"]):
            job["pid"] = 0
        if job["pid"]:
            continue
        now = time.monotonic()
        since = now - job.get("lastStart", 0.0)
        if job["keepAlive"] and since > 1.0:
            start_job(job)
        elif job.get("startInterval", 0) > 0 and \
                since >= job["startInterval"]:
            start_job(job)


def load_job_into_runtime(path):
    job = parse_job(path)
    old = jobs.get(job["label"])
    if old and old is not job:
        for listener in old.get("listeners", {}).values():
            try:
                listener.close()
            except OSError:
                pass
        for sock_path in old.get("socketPaths", []):
            try:
                os.unlink(sock_path)
            except FileNotFoundError:
                pass
    jobs[job["label"]] = job
    ensure_job_sockets(job)
    print(f"launchd_sim: job {job['label']} loaded", flush=True)
    if job["runAtLoad"]:
        start_job(job)
    return {"ok": True, "label": job["label"]}


def unload_job(label):
    job = jobs.pop(label, None)
    if job is None:
        return {"ok": False, "error": "unknown job"}
    pid = job.get("pid", 0)
    if pid:
        try:
            os.killpg(pid, signal.SIGCONT)
            os.killpg(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    proc = job.get("proc")
    if proc is not None:
        try:
            proc.wait(timeout=2.0)
        except Exception:
            pass
    for listener in job.get("listeners", {}).values():
        try:
            listener.close()
        except OSError:
            pass
    for sock_path in job.get("socketPaths", []):
        try:
            os.unlink(sock_path)
        except FileNotFoundError:
            pass
    print(f"launchd_sim: job {label} unloaded", flush=True)
    return {"ok": True, "label": label}


def job_for_service(name):
    for job in jobs.values():
        if name in job["machServices"]:
            return job
    return None


def stop_jobs():
    for job in jobs.values():
        pid = job.get("pid", 0)
        if pid:
            try:
                os.killpg(pid, signal.SIGCONT)
                os.killpg(pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        job["pid"] = 0
        job["proc"] = None
        for listener in job.get("listeners", {}).values():
            try:
                listener.close()
            except OSError:
                pass
        job["listeners"] = {}
        for sock_path in job.get("socketPaths", []):
            try:
                os.unlink(sock_path)
            except FileNotFoundError:
                pass
        job["socketPaths"] = []


def boot_springboard(ctl, device_dir, udid, name):
    """Start the system UI with the apps installed on this device."""
    global springboard_pid
    state = ctl.load_state()
    dev = state["devices"].get(udid)
    if dev is None:
        print("launchd_sim: device not in state; skipping SpringBoard",
              flush=True)
        return
    manifest = ctl.write_springboard_manifest(udid, dev)
    sb = ctl.runtime_root() / "System" / "Library" / "CoreServices" / \
        "SpringBoard.app" / "SpringBoard"
    if not sb.exists():
        print("launchd_sim: SpringBoard not built (tools/build_runtime.sh)",
              flush=True)
        return
    var_run = os.path.join(device_dir, "var", "run")
    fifo = ctl.event_fifo_path(udid)
    if not fifo.exists():
        os.mkfifo(str(fifo))
    env = ctl.device_environment(udid, dev)
    env["IOSIM_SHELL"] = "1"
    env["IOSIM_SHELL_APPS"] = str(manifest)
    env["IOSIM_EVENT_FIFO"] = str(fifo)
    cmd = [ctl.loader_path()]
    for p in dev.get("dylibPaths", []):
        cmd += ["--dylib-path", p]
    cmd += [str(sb)]
    log_path = os.path.join(device_dir, "logs", "springboard.log")
    log = open(log_path, "ab")
    proc = subprocess.Popen(cmd, env=env, stdout=log, stderr=log,
                            start_new_session=True, cwd=os.path.dirname(device_dir))
    springboard_pid = proc.pid
    log.close()
    print(f"launchd_sim: SpringBoard started pid={proc.pid}", flush=True)


def main():
    global running
    if len(sys.argv) < 4:
        print("usage: iosim-launchd <device-dir> <udid> <name>", file=sys.stderr)
        return 2
    device_dir, udid, name = sys.argv[1], sys.argv[2], sys.argv[3]
    var_run = os.path.join(device_dir, "var", "run")
    os.makedirs(var_run, exist_ok=True)
    os.makedirs(os.path.join(device_dir, "logs"), exist_ok=True)
    # AF_UNIX paths are limited to 108 bytes; the device set path can be
    # longer than that, so the control socket lives under /tmp.
    sock_path = f"/tmp/iosim-launchd-{udid}.sock"
    state_path = os.path.join(var_run, "launchd.json")
    try:
        os.unlink(sock_path)
    except FileNotFoundError:
        pass

    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)

    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(sock_path)
    srv.listen(8)
    srv.setblocking(False)
    os.chmod(sock_path, 0o600)

    state = {
        "pid": os.getpid(),
        "udid": udid,
        "name": name,
        "startedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "services": {},
    }

    def persist():
        state["springboardPid"] = springboard_pid
        with open(state_path, "w") as f:
            json.dump(state, f, indent=2)

    def prune_services():
        """Forget names whose registering process no longer exists."""
        services = state["services"]
        for svc in list(services):
            pid = services[svc].get("pid", 0)
            try:
                os.kill(pid, 0)
            except (ProcessLookupError, PermissionError):
                if pid:
                    del services[svc]

    def register_service(name, pid):
        prune_services()
        services = state["services"]
        if not name or len(name) > 88 or pid <= 0:
            return {"ok": False, "error": "bad request"}
        held = services.get(name)
        if held is not None:
            return {"ok": False, "error": "active"}
        services[name] = {
            "pid": pid,
            "registeredAt": time.strftime("%Y-%m-%dT%H:%M:%SZ",
                                          time.gmtime()),
        }
        persist()
        print(f"launchd_sim: service {name} registered by pid {pid}",
              flush=True)
        return {"ok": True}

    def lookup_service(name):
        prune_services()
        held = state["services"].get(name)
        if held is not None and pid_alive(held.get("pid", 0)):
            return {"ok": True, "pid": held.get("pid", 0)}
        prune_jobs()
        job = job_for_service(name)
        if job is None:
            return {"ok": False, "error": "unknown service"}
        if not pid_alive(job["pid"]):
            start_job(job)
        # The client retries while the job starts and registers the name.
        return {"ok": False, "error": "starting"}

    persist()
    print(f"launchd_sim: booting {name} ({udid}) pid={os.getpid()}", flush=True)

    ctl = load_ctl()
    dev = ctl.load_state().get("devices", {}).get(udid) or {}
    job_ctx.update({"ctl": ctl, "udid": udid, "dev": dev,
                    "device_dir": device_dir})
    jobs.update(scan_jobs(device_dir))
    for job in jobs.values():
        ensure_job_sockets(job)

    try:
        boot_springboard(ctl, device_dir, udid, name)
    except Exception as exc:  # keep the boot anchor alive regardless
        print(f"launchd_sim: SpringBoard boot failed: {exc}", flush=True)
    for job in list(jobs.values()):
        if job["runAtLoad"]:
            start_job(job)
    persist()

    while running:
        listener_jobs = []
        for job in jobs.values():
            for listener in job.get("listeners", {}).values():
                listener_jobs.append((listener, job))
        rlist = [srv] + [entry[0] for entry in listener_jobs]
        try:
            ready, _, _ = select.select(rlist, [], [], 0.5)
        except InterruptedError:
            continue
        prune_jobs()
        if not ready:
            continue
        for listener, job in listener_jobs:
            if listener not in ready:
                continue
            proc = job.get("proc")
            alive = proc.poll() is None if proc is not None \
                else pid_alive(job["pid"])
            if alive:
                continue
            if proc is not None:
                job["proc"] = None
                job["pid"] = 0
            print(f"launchd_sim: job {job['label']} activated by socket",
                  flush=True)
            start_job(job)
        if srv not in ready:
            if listener_jobs:
                time.sleep(0.01)
            continue
        try:
            conn, _ = srv.accept()
        except BlockingIOError:
            continue
        with conn:
            conn.settimeout(1.0)
            try:
                data = conn.recv(65536)
                req = json.loads(data or b"{}")
            except Exception:
                req = {}
            cmd = req.get("cmd")
            if cmd == "ping":
                resp = {"ok": True, "pid": os.getpid()}
            elif cmd == "status":
                prune_services()
                prune_jobs()
                resp = {"ok": True, "state": state,
                        "jobs": [{"label": j["label"], "pid": j["pid"],
                                  "services": j["machServices"]}
                                 for j in jobs.values()]}
            elif cmd == "service_register":
                resp = register_service(str(req.get("name", "")),
                                        int(req.get("pid", 0) or 0))
            elif cmd == "service_lookup":
                resp = lookup_service(str(req.get("name", "")))
            elif cmd == "job_load":
                try:
                    resp = load_job_into_runtime(str(req.get("path", "")))
                except Exception as exc:
                    resp = {"ok": False, "error": str(exc)}
            elif cmd == "job_unload":
                resp = unload_job(str(req.get("label", "")))
            elif cmd == "job_list":
                prune_jobs()
                resp = {"ok": True,
                        "jobs": [{"label": j["label"], "pid": j["pid"],
                                  "services": j["machServices"]}
                                 for j in jobs.values()]}
            elif cmd == "shutdown":
                resp = {"ok": True}
                running = False
            else:
                resp = {"ok": False, "error": "unknown command"}
            try:
                conn.sendall((json.dumps(resp) + "\n").encode())
            except OSError:
                pass

    stop_jobs()
    stop_springboard()
    try:
        os.unlink(sock_path)
    except FileNotFoundError:
        pass
    try:
        os.unlink(state_path)
    except FileNotFoundError:
        pass
    print("launchd_sim: shutting down", flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
